{
  "name": "open-saas-mobile",
  "private": true,
  "version": "1.5.26",
  "type": "module",
  "scripts": {
    "dev:c": "vite --config vite.config.c.js",
    "dev:b": "vite --config vite.config.b.js",
    "build:b": "vite build --config vite.config.b.js",
